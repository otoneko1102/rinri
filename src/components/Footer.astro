---
import { Icon } from 'astro-icon/components';
import { DISCORD_URL, GITHUB_URL } from '../settings/config.js';
---

<footer>
  <p class="license">
    コンテンツは
    <a href={`${GITHUB_URL}/blob/main/LICENSE-MIT`} target="_blank" rel="noopener noreferrer">LICENSE-MIT</a>
    &amp;
    <a href={`${GITHUB_URL}/blob/main/LICENSE-CC-BY-4.0`} target="_blank" rel="noopener noreferrer">LICENSE-CC-BY-4.0</a>
    &amp;
    <a href={`${GITHUB_URL}/blob/main/LICENSE-RINRI-1.0`} target="_blank" rel="noopener noreferrer">LICENSE-RINRI-1.0</a>
    の下で提供されます。
  </p>
  <div class="icons">
    <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" aria-label="Discord">
      <Icon name="simple-icons:discord" width="18" height="18" aria-hidden="true" />
    </a>
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <Icon name="simple-icons:github" width="18" height="18" aria-hidden="true" />
    </a>
  </div>
</footer>

<style>
  footer {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    box-sizing: border-box;
  }

  .license {
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .license {
      font-size: clamp(0.45rem, 2.5vw, 0.7rem);
    }
  }

  .license a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.12s;
  }

  .license a:hover {
    color: var(--fg);
  }

  .icons {
    display: flex;
    gap: 0.6rem;
  }

  .icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--btn-bg);
    text-decoration: none;
    transition: color 0.12s, background 0.12s, box-shadow 0.12s;
  }

  .icons a:hover {
    color: var(--fg);
    background: var(--btn-hover);
    box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  }
</style>
